{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^watch"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"cache": false
		},
		"watch": {}
	}
}
